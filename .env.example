# Google OAuth Web client. Register BASE_URL/auth/google/callback as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
# Local web app; PostgreSQL recommended. SQLite is suitable only for tests.
DATABASE_URL=postgresql+psycopg://assistant_agent:change-me@localhost:5432/assistant_agent
# For local Compose only; use the same value in deploy/local-db-password.txt.
POSTGRES_PASSWORD=change-me
# Local sandbox Claude authentication.
ANTHROPIC_API_KEY=
APP_ENV=development
HOST=localhost
PORT=8000
BASE_URL=http://localhost:8000
