# Google OAuth Web client. Register BASE_URL/auth/google/callback as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
# Local web app; PostgreSQL recommended. SQLite is suitable only for tests.
DATABASE_URL=postgresql+psycopg://assistant_agent:change-me@localhost:5432/assistant_agent
# For local Compose only; use the same value in deploy/local-db-password.txt.
POSTGRES_PASSWORD=change-me
# Claude authentication is passed to the conversation exec, never container-wide.
ANTHROPIC_API_KEY=
APP_ENV=development
HOST=localhost
PORT=8000
BASE_URL=http://localhost:8000

# Live-only Claude chat (one app worker/replica per deployment).
CHAT_MAX_SESSIONS=4
CHAT_IDLE_SECONDS=1800

# Sandbox images must already exist; chat requests never pull them.
SANDBOX_IMAGE=assistant-agent-sandbox:local
SANDBOX_DEPLOYMENT_ID=local
SANDBOX_NETWORK=assistant-agent-local-sandboxes
# deploy/local.sh resolves SANDBOX_HOST_INPUT_ROOT to absolute <repo>/data/session-inputs.
# For a host-run app, use absolute paths for both settings and create/chown the root.
# SANDBOX_HOST_INPUT_ROOT=/absolute/path/to/assistant-agent/data/session-inputs
SANDBOX_APP_INPUT_ROOT=/srv/assistant-agent/session-inputs
