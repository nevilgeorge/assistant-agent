# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets
.env
.env.*
!.env.example

# Stored OAuth credentials
data/

# Google credential files downloaded from Cloud Console.
# The app reads its client id/secret from .env, but the console hands you a
# JSON file by default and it lands in the project root.
client_secret*.json
credentials.json
token.json
tokens.json
*-service-account*.json
*.p12
*.pem

# Derived output from the export index tooling. build_index.py writes
# `events.jsonl` in the current directory and `.index/` beside itself, so running
# one from the repo root or from src/assistant_agent/agent_kit/ would otherwise
# leave private mail-derived output in a tracked path.
.index/
*.jsonl

# Editor and OS cruft
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Logs
*.log
# Deployment outputs and local secrets
*.tfstate*
.terraform/
deploy/local-db-password.txt
deploy/.env.production
